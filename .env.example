NODE_ENV=development
PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://restaurantflow:restaurantflow@localhost:5432/restaurantflow
TRUST_PROXY=disabled
READINESS_TIMEOUT_MS=2000
TRANSACTIONAL_EMAIL_PROVIDER=disabled
BREVO_API_KEY=
TRANSACTIONAL_EMAIL_FROM_ADDRESS=
TRANSACTIONAL_EMAIL_FROM_NAME=FlowGastronomie
TRANSACTIONAL_EMAIL_TIMEOUT_MS=5000

# Explicit test/dev only; production always rejects simulator commands.
HARDWARE_SIMULATOR_ENABLED=false
# Production Android command signer: base64 PKCS8 RSA private key; server only.
HARDWARE_COMMAND_PRIVATE_KEY_BASE64=

# Creative Studio: optional AI; manual editor/export does not require credentials.
CREATIVE_OPENAI_API_KEY=
CREATIVE_PLANNER_MODEL=gpt-6-luna
CREATIVE_PLANNER_QUALITY_MODEL=gpt-6-sol
CREATIVE_IMAGE_MODEL=gpt-image-2.5-flare
# Approved public origin used to construct QR destinations (no trailing path).
CREATIVE_PUBLIC_ORIGIN=http://localhost:3000
# Private persistent directory for assets and exports. Back up alongside PostgreSQL.
CREATIVE_STORAGE_DIR=.creative-assets

# Smart Setup menu extraction: disabled until explicitly configured server-side.
# Existing CREATIVE_OPENAI_API_KEY can be reused when the dedicated key is empty.
MENU_IMPORT_PROVIDER=disabled
MENU_IMPORT_OPENAI_API_KEY=
MENU_IMPORT_MODEL=gpt-5-mini

# Optional reviewed website title/description assistant; shares Creative credentials.
# Disabled by default; enable only after provider/cost acceptance.
WEBSITE_COPY_AI_ENABLED=false

# Smart Business Import V2: public HTTPS discovery is deterministic by default.
# Enabling paid extraction requires separate owner/operator cost authorization.
BUSINESS_IMPORT_ALLOW_PAID_AI=false
# Optional prebuilt isolated renderer image: sha256:<64 hex> or registry/name@sha256:...
BUSINESS_IMPORT_RENDERER_IMAGE=
BUSINESS_IMPORT_REQUESTS=30
BUSINESS_IMPORT_PAGES=8
BUSINESS_IMPORT_DEPTH=2
BUSINESS_IMPORT_TOTAL_BYTES=24000000
BUSINESS_IMPORT_FILE_BYTES=10000000
BUSINESS_IMPORT_PAGE_BYTES=1000000
BUSINESS_IMPORT_TIMEOUT_MS=60000
BUSINESS_IMPORT_REQUEST_MS=8000
BUSINESS_IMPORT_PROVIDER_MS=150000
BUSINESS_IMPORT_USER_PER_HOUR=10
BUSINESS_IMPORT_TENANT_PER_HOUR=30

# Private work documents: independent server-only 32-byte AES key, base64.
WORKFORCE_DOCUMENT_KEY=

# Workforce outbox worker: manual operator opt-in; disabled by default.
WORKFORCE_NOTIFICATION_WORKER_ENABLED=false
# Existing transactional email provider is reused; no second email credentials.
# Optional browser Web Push transport. Public key may be disclosed to opted-in
# authenticated staff; the private VAPID key stays exclusively server-side.
WORKFORCE_PUSH_PROVIDER=disabled
WORKFORCE_VAPID_PUBLIC_KEY=
WORKFORCE_VAPID_PRIVATE_KEY=
WORKFORCE_VAPID_SUBJECT=
