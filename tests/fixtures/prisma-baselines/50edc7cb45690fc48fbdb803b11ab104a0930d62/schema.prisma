generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  MANAGER
  WAITER
  BAR
  KITCHEN
}

enum Locale {
  EN
  DE
  IT
  SQ
}

enum ServiceMode {
  MENU_ONLY
  CALL_AND_REQUEST
  ORDER_AND_CONFIRM
  SELF_ORDER
  ORDER_AND_PAY
  BAR
  TAKEAWAY
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderStatusEventKind {
  INITIAL
  TRANSITION
}

enum OperationalOrderKind {
  TABLE
  ONLINE
}

enum OperationalOrderEventType {
  ORDER_CREATED
  ORDER_STATUS_CHANGED
}

enum IngredientBaseUnit {
  GRAM
  MILLILITER
  PIECE
}

enum IngredientQuantityUnit {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PIECE
}

enum StationType {
  BAR
  KITCHEN
  DESSERT
}

enum ServiceSignalType {
  NEW_ORDER
  WAITER_CALL
  BILL_REQUEST
  WATER_REQUEST
}

enum AllergenCode {
  GLUTEN
  CRUSTACEANS
  EGGS
  FISH
  PEANUTS
  SOY
  MILK
  NUTS
  CELERY
  MUSTARD
  SESAME
  SULPHITES
  LUPIN
  MOLLUSCS
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
}

enum OperationalTaskScope {
  VENUE
  SHIFT
  TABLE
  ORDER
}

enum OperationalTaskPriority {
  LOW
  NORMAL
  HIGH
}

enum ReservationStatus {
  REQUESTED
  CONFIRMED
  SEATED
  COMPLETED
  REJECTED
  CANCELLED
  NO_SHOW
}

enum StaffShiftStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  CARD_AT_COUNTER
  CARD_AT_TABLE
  OTHER
}

enum PaymentRecordStatus {
  RECORDED
  VOIDED
}

enum ProductionTicketStatus {
  NEW
  PREPARING
  READY
  SERVED
}

enum OrderSource {
  GUEST_QR
  STAFF_TABLET
}

enum OnlineFulfillmentType {
  PICKUP
  DELIVERY
  CATERING
}

enum OnlineOrderStatus {
  PENDING_CONFIRMATION
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  REJECTED
  CANCELLED
}

enum OnlineOrderMessageAuthor {
  GUEST
  STAFF
}

enum SubscriptionPlan {
  WEBSITE
  SMART_SERVICE
  RESTAURANT_PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum WebsiteStatus {
  DRAFT
  PUBLISHED
}

enum WebsiteDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
}

enum WebsiteAssetKind {
  LOGO
  HERO
}

enum BillingInvoiceStatus {
  OPEN
  PAID
  VOID
}

enum PlanChangeStatus {
  PENDING
  APPLIED
  CANCELLED
}

enum TenantKind {
  REAL
  DEMO
  LOCAL_PILOT
  LEGACY_CI
}

model BusinessProvision {
  requestKeyHash String @id
  fingerprint String
  tenantId String @unique
  venueId String
  ownerId String
  profileSnapshot Json
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  venue Venue @relation(fields: [tenantId, venueId], references: [tenantId, id], onDelete: Restrict)
  owner User @relation(fields: [tenantId, ownerId], references: [tenantId, id], onDelete: Restrict)
}

model Tenant {
  demoWorkspace DemoWorkspace?
  retiredAt DateTime?
  hardwareDevices  HardwareDevice[]
  printJobs        PrintJob[]
  hardwareCommands HardwareCommandRecord[]
  cashSessions     CashSession[]
  receipts         Receipt[]
  receiptSequences ReceiptSequence[]
  taxCategories    TaxCategory[]
  id               String                          @id @default(cuid())
  name             String
  kind             TenantKind @default(REAL)
  businessProfileId String?
  businessProfileVersion Int?
  provision BusinessProvision?
  slug             String                          @unique
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  venues           Venue[]
  memberships      Membership[]
  users            User[]
  staffSessions    StaffSession[]
  staffShifts      StaffShift[]
  auditEvents      AuditEvent[]
  paymentRecords   PaymentRecord[]
  staffInvitations StaffInvitation[]
  subscription     Subscription?
  entitlements     Entitlement[]
  usageRecords     SubscriptionUsage[]
  websites         VenueWebsite[]
  websiteDomains   WebsiteDomain[]
  websiteAssets    WebsiteAsset[]
  websiteRevisions WebsitePublicationRevision[]
  billingProfile   OrganizationBillingProfile?
  billingInvoices  BillingInvoice[]
  planChanges      SubscriptionPlanChangeRequest[]
  venueLaunches    VenueLaunch[]
  customerProfiles CustomerProfile[]
}

model DemoWorkspace {
  profileId String @id
  generation Int @default(1)
  tenantId String @unique
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt
}

model User {
  id            String         @id @default(cuid())
  tenantId      String
  email         String
  displayName   String
  passwordHash  String
  active        Boolean        @default(true)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships   Membership[]
  staffSessions StaffSession[]
  provisions BusinessProvision[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Membership {
  cashSessions           CashSession[]
  id                     String                  @id @default(cuid())
  tenantId               String
  venueId                String
  userId                 String
  role                   MembershipRole
  active                 Boolean                 @default(true)
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue                  Venue                   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffSessions          StaffSession[]
  staffProfile           StaffProfile?
  staffShifts            StaffShift[]
  scheduleAssignments    ScheduleAssignment[]
  staffAvailabilityNotes StaffAvailabilityNote[]

  @@unique([venueId, userId])
  @@index([tenantId])
}

model StaffSession {
  id           String     @id @default(cuid())
  tenantId     String
  venueId      String
  userId       String
  membershipId String
  tokenHash    String     @unique
  createdAt    DateTime   @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue        Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, venueId, userId, expiresAt])
}

model Venue {
  smartSetup                 SmartSetup?
  importSessions             ImportSession[]
  city String?
  entrance String?
  mediaAssets MediaAsset[]
  media VenueMedia[]
  creativeProjects           CreativeProject[]
  creativeAssets             CreativeAsset[]
  hardwareDevices            HardwareDevice[]
  printJobs                  PrintJob[]
  hardwareCommands           HardwareCommandRecord[]
  cashSessions               CashSession[]
  receipts                   Receipt[]
  receiptSequence            ReceiptSequence?
  taxCategories              TaxCategory[]
  id                         String                       @id @default(cuid())
  tenantId                   String
  name                       String
  slug                       String
  countryCode                String?
  timezone                   String                       @default("Europe/Berlin")
  currency                   String                       @default("EUR")
  defaultLocale              Locale                       @default(SQ)
  defaultServiceMode         ServiceMode                  @default(MENU_ONLY)
  onlinePickupEnabled        Boolean                      @default(true)
  pickupLeadMinutes          Int?
  onlineDeliveryEnabled      Boolean                      @default(true)
  onlineCateringEnabled      Boolean                      @default(true)
  reservationCapacity        Int                          @default(40)
  reservationDurationMinutes Int                          @default(120)
  reservationAutoConfirm     Boolean                      @default(false)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  tenant                     Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships                Membership[]
  staffSessions              StaffSession[]
  areas                      Area[]
  tables                     DiningTable[]
  categories                 MenuCategory[]
  categoryTranslations       MenuCategoryTranslation[]
  products                   Product[]
  productTranslations        ProductTranslation[]
  sessions                   TableSession[]
  orders                     Order[]
  onlineOrders               OnlineOrder[]
  deliveryZones              DeliveryZone[]
  signals                    ServiceSignal[]
  staffShifts                StaffShift[]
  auditEvents                AuditEvent[]
  paymentRecords             PaymentRecord[]
  staffInvitations           StaffInvitation[]
  website                    VenueWebsite?
  websiteDomain              WebsiteDomain?
  websiteAssets              WebsiteAsset[]
  websiteRevisions           WebsitePublicationRevision[]
  launch                     VenueLaunch?
  schedules                  VenueSchedule[]
  scheduleAssignments        ScheduleAssignment[]
  availabilityNotes          StaffAvailabilityNote[]
  operationalTasks           OperationalTask[]
  handoverNotes              ShiftHandoverNote[]
  reservations               Reservation[]
  customerProfiles           CustomerProfile[]
  provisions BusinessProvision[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model SmartSetup {
  id                    String         @id @default(cuid())
  tenantId              String
  venueId               String
  profileId             String
  profileVersion        Int
  step                  Int            @default(1)
  status                String         @default("IN_PROGRESS")
  skipped               String[]       @default([])
  appliedProfiles       String[]       @default([])
  version               Int            @default(0)
  activeImportSessionId String?
  mediaStep             Int            @default(1)
  mediaStatus           String         @default("PENDING")
  mediaDraft            Json?
  updatedBy             String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  venue                 Venue          @relation(fields: [tenantId, venueId], references: [tenantId, id], onDelete: Cascade)
  activeImportSession   ImportSession? @relation(fields: [tenantId, venueId, activeImportSessionId], references: [tenantId, venueId, id], onDelete: Restrict)

  @@unique([tenantId, venueId])
}

model ImportSession {
  businessData         Json?
  businessReceipt      Json?
  id                   String         @id @default(cuid())
  tenantId             String
  venueId              String
  requestKey           String
  locale               Locale
  status               String         @default("DETECTED")
  version              Int            @default(0)
  extractionState      String         @default("PENDING")
  extractionKey        String?
  extractionAttempts   Int            @default(0)
  extractionStartedAt  DateTime?
  extractionFinishedAt DateTime?
  provider             String?
  model                String?
  provenance           Json?
  proposal             Json?
  errorCode            String?
  importedAt           DateTime?
  importedBy           String?
  createdBy            String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  venue                Venue          @relation(fields: [tenantId, venueId], references: [tenantId, id], onDelete: Cascade)
  setups               SmartSetup[]
  sources              ImportSource[]
  items                ImportItem[]

  @@unique([tenantId, venueId, id])
  @@unique([tenantId, venueId, requestKey])
  @@index([tenantId, venueId, createdAt])
}

model ImportSource {
  sourceUrl     String?
  method        String        @default("DOCUMENT")
  id            String        @id @default(cuid())
  tenantId      String
  venueId       String
  sessionId     String
  filename      String
  mimeType      String
  contentHash   String
  byteSize      Int
  pageCount     Int
  mediaAssetId  String?
  documentBytes Bytes?
  createdAt     DateTime      @default(now())
  session       ImportSession @relation(fields: [tenantId, venueId, sessionId], references: [tenantId, venueId, id], onDelete: Cascade)
  mediaAsset    MediaAsset?   @relation(fields: [tenantId, venueId, mediaAssetId], references: [tenantId, venueId, id], onDelete: Restrict)

  @@unique([tenantId, venueId, id])
  @@unique([tenantId, venueId, sessionId, contentHash])
}

model ImportItem {
  id                String        @id @default(cuid())
  tenantId          String
  venueId           String
  sessionId         String
  proposalItemId    String
  status            String        @default("NEEDS_REVIEW")
  original          Json
  reviewed          Json
  approvedBy        String?
  approvedAt        DateTime?
  importedProductId String?
  updatedAt         DateTime      @updatedAt
  session           ImportSession @relation(fields: [tenantId, venueId, sessionId], references: [tenantId, venueId, id], onDelete: Cascade)
  importedProduct   Product?      @relation(fields: [tenantId, venueId, importedProductId], references: [tenantId, venueId, id], onDelete: Restrict)

  @@unique([tenantId, venueId, id])
  @@unique([tenantId, venueId, sessionId, proposalItemId])
}

model VenueWebsite {
  premiumStyleId String?
  id           String                       @id @default(cuid())
  tenantId     String
  venueId      String                       @unique
  publicSlug   String                       @unique
  status       WebsiteStatus                @default(DRAFT)
  primaryColor String                       @default("#17382f")
  accentColor  String                       @default("#ed6b37")
  logoUrl      String?
  heroImageUrl String?
  phone        String?
  contactEmail String?
  address      String?
  instagramUrl String?
  facebookUrl  String?
  openingHours Json
  publishedAt  DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  tenant       Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue        Venue                        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  translations VenueWebsiteTranslation[]
  domain       WebsiteDomain?
  assets       WebsiteAsset[]
  revisions    WebsitePublicationRevision[]

  @@index([tenantId, status])
}

model WebsiteDomain {
  id                String              @id @default(cuid())
  tenantId          String
  venueId           String              @unique
  websiteId         String              @unique
  hostname          String              @unique
  status            WebsiteDomainStatus @default(PENDING)
  verificationToken String
  lastCheckedAt     DateTime?
  verifiedAt        DateTime?
  activatedAt       DateTime?
  failureReason     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue             Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  website           VenueWebsite        @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model WebsiteAsset {
  id         String           @id @default(cuid())
  tenantId   String
  venueId    String
  websiteId  String
  kind       WebsiteAssetKind
  mimeType   String
  byteLength Int
  bytes      Bytes
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue      Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  website    VenueWebsite     @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, kind])
  @@index([tenantId, venueId])
}

model WebsitePublicationRevision {
  id                      String       @id @default(cuid())
  tenantId                String
  venueId                 String
  websiteId               String
  revision                Int
  snapshot                Json
  publishedByUserId       String
  publishedByMembershipId String
  publishedAt             DateTime     @default(now())
  tenant                  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue                   Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  website                 VenueWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, revision])
  @@index([tenantId, venueId, publishedAt])
}

model VenueLaunch {
  id                   String    @id @default(cuid())
  tenantId             String
  venueId              String    @unique
  rehearsalConfirmedAt DateTime?
  rehearsalByUserId    String?
  launchedAt           DateTime?
  launchedByUserId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue                Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([tenantId, launchedAt])
}

model VenueWebsiteTranslation {
  id             String       @id @default(cuid())
  tenantId       String
  venueId        String
  websiteId      String
  locale         Locale
  heroTitle      String
  heroSubtitle   String
  storyTitle     String
  storyBody      String
  seoTitle       String
  seoDescription String
  website        VenueWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, locale])
  @@index([tenantId, venueId, locale])
}

model Area {
  id                  String        @id @default(cuid())
  tenantId            String
  venueId             String
  name                String
  serviceModeOverride ServiceMode?
  venue               Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tables              DiningTable[]

  @@unique([venueId, name])
  @@index([tenantId, venueId])
}

model DiningTable {
  id                  String            @id @default(cuid())
  tenantId            String
  venueId             String
  areaId              String?
  label               String
  qrTokenHash         String            @unique
  qrRevokedAt         DateTime?
  serviceModeOverride ServiceMode?
  venue               Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  area                Area?             @relation(fields: [areaId], references: [id], onDelete: SetNull)
  sessions            TableSession[]
  signals             ServiceSignal[]
  assignments         TableAssignment[]
  reservations        Reservation[]
  orders              Order[]

  @@unique([venueId, label])
  @@index([tenantId, venueId])
}

model MenuCategory {
  id           String                    @id @default(cuid())
  tenantId     String
  venueId      String
  sortOrder    Int                       @default(0)
  published    Boolean                   @default(false)
  venue        Venue                     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  products     Product[]
  translations MenuCategoryTranslation[]

  @@index([tenantId, venueId, published])
}

model MenuCategoryTranslation {
  id         String       @id @default(cuid())
  tenantId   String
  venueId    String
  categoryId String
  locale     Locale
  name       String
  venue      Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([tenantId, venueId, locale])
}

model Product {
  archivedAt      DateTime?
  importItems      ImportItem[]
  dataProvenance Json?
  media ProductMedia[]
  taxCategoryId    String?
  taxCategory      TaxCategory?           @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)
  id               String                 @id @default(cuid())
  tenantId         String
  venueId          String
  categoryId       String
  priceMinor       Int
  currency         String                 @default("EUR")
  sortOrder        Int                    @default(0)
  available        Boolean                @default(true)
  published        Boolean                @default(false)
  station          StationType
  venue            Venue                  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category         MenuCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations     ProductTranslation[]
  orderItems       OrderItem[]
  onlineOrderItems OnlineOrderItem[]
  variants         ProductVariant[]
  modifierGroups   ProductModifierGroup[]
  allergens        ProductAllergen[]
  recipe           Recipe?

  @@index([tenantId, venueId, categoryId, published])
  @@unique([tenantId, venueId, id])
}

enum MediaSource {
  UPLOAD
  IMPORT
  GENERATED
  DEMO
  SYSTEM
}
enum VenueMediaRole {
  LOGO
  HERO
  GALLERY
  PROFILE
}
enum ProductMediaRole {
  PRIMARY
  GALLERY
}
model MediaAsset {
  importSources        ImportSource[]
  id String @id @default(cuid())
  tenantId String
  venueId String
  source MediaSource
  sourceKey String
  mimeType String
  width Int
  height Int
  contentHash String
  storageLocation String @default("DATABASE")
  bytes Bytes
  provenance Json
  approvedForPublicUse Boolean @default(false)
  createdByUserId String
  approvedByUserId String
  approvedAt DateTime @default(now())
  createdAt DateTime @default(now())
  venue Venue @relation(fields: [tenantId, venueId], references: [tenantId, id], onDelete: Restrict)
  venueMedia VenueMedia[]
  productMedia ProductMedia[]
  @@unique([tenantId, venueId, id])
  @@unique([tenantId, venueId, sourceKey])
}
model VenueMedia {
  id String @id @default(cuid())
  tenantId String
  venueId String
  mediaAssetId String
  role VenueMediaRole
  sortOrder Int @default(0)
  venue Venue @relation(fields: [tenantId, venueId], references: [tenantId, id], onDelete: Restrict)
  asset MediaAsset @relation(fields: [tenantId, venueId, mediaAssetId], references: [tenantId, venueId, id], onDelete: Restrict)
  @@unique([tenantId, venueId, role, sortOrder])
}
model ProductMedia {
  id String @id @default(cuid())
  tenantId String
  venueId String
  productId String
  mediaAssetId String
  role ProductMediaRole
  sortOrder Int @default(0)
  product Product @relation(fields: [tenantId, venueId, productId], references: [tenantId, venueId, id], onDelete: Restrict)
  asset MediaAsset @relation(fields: [tenantId, venueId, mediaAssetId], references: [tenantId, venueId, id], onDelete: Restrict)
  @@unique([tenantId, venueId, productId, role, sortOrder])
}

model ProductVariant {
  id              String                      @id @default(cuid())
  tenantId        String
  venueId         String
  productId       String
  priceDeltaMinor Int                         @default(0)
  sortOrder       Int                         @default(0)
  available       Boolean                     @default(true)
  isDefault       Boolean                     @default(false)
  product         Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations    ProductVariantTranslation[]

  @@index([tenantId, venueId, productId, available])
}

model ProductVariantTranslation {
  id        String         @id @default(cuid())
  variantId String
  locale    Locale
  name      String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, locale])
}

model ProductModifierGroup {
  id           String                            @id @default(cuid())
  tenantId     String
  venueId      String
  productId    String
  minSelect    Int                               @default(0)
  maxSelect    Int                               @default(1)
  sortOrder    Int                               @default(0)
  product      Product                           @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations ProductModifierGroupTranslation[]
  options      ProductModifierOption[]

  @@index([tenantId, venueId, productId])
}

model ProductModifierGroupTranslation {
  id      String               @id @default(cuid())
  groupId String
  locale  Locale
  name    String
  group   ProductModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, locale])
}

model ProductModifierOption {
  id              String                             @id @default(cuid())
  tenantId        String
  venueId         String
  groupId         String
  priceDeltaMinor Int                                @default(0)
  sortOrder       Int                                @default(0)
  available       Boolean                            @default(true)
  group           ProductModifierGroup               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  translations    ProductModifierOptionTranslation[]

  @@index([tenantId, venueId, groupId, available])
}

model ProductModifierOptionTranslation {
  id       String                @id @default(cuid())
  optionId String
  locale   Locale
  name     String
  option   ProductModifierOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, locale])
}

model ProductAllergen {
  productId String
  allergen  AllergenCode
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, allergen])
}

model ProductTranslation {
  id          String  @id @default(cuid())
  tenantId    String
  venueId     String
  productId   String
  locale      Locale
  name        String
  description String?
  venue       Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([tenantId, venueId, locale])
}

model TableSession {
  id             String          @id @default(cuid())
  tenantId       String
  venueId        String
  tableId        String
  status         SessionStatus   @default(OPEN)
  activeTableKey String?         @unique
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
