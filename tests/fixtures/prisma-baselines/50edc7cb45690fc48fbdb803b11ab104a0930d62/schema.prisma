  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BillingInvoice {
  id             String               @id @default(cuid())
  tenantId       String
  subscriptionId String
  number         String               @unique
  status         BillingInvoiceStatus
  amountMinor    Int
  currency       String               @default("EUR")
  periodStart    DateTime
  periodEnd      DateTime
  issuedAt       DateTime
  dueAt          DateTime
  paidAt         DateTime?
  externalUrl    String?
  createdAt      DateTime             @default(now())
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, issuedAt])
}

model SubscriptionPlanChangeRequest {
  id                      String           @id @default(cuid())
  tenantId                String
  subscriptionId          String
  currentPlan             SubscriptionPlan
  requestedPlan           SubscriptionPlan
  status                  PlanChangeStatus @default(PENDING)
  requestedByUserId       String
  requestedByMembershipId String
  requestedAt             DateTime         @default(now())
  resolvedAt              DateTime?
  tenant                  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription            Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, requestedAt])
}

model Entitlement {
  id             String       @id @default(cuid())
  tenantId       String
  subscriptionId String
  featureKey     String
  enabled        Boolean      @default(false)
  limitInt       Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, featureKey])
  @@index([tenantId, featureKey, enabled])
}

model SubscriptionUsage {
  id             String       @id @default(cuid())
  tenantId       String
  subscriptionId String
  usageKey       String
  quantity       Int          @default(0)
  measuredAt     DateTime     @default(now())
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, usageKey])
  @@index([tenantId, usageKey])
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum ReceiptStatus {
  FINALIZED
}

model CashSession {
  id                   String            @id @default(cuid())
  tenantId             String
  venueId              String
  openedByMembershipId String
  shiftId              String
  openedAt             DateTime          @default(now())
  closedAt             DateTime?
  closedByMembershipId String?
  closedByShiftId      String?
  openingCashMinor     Int
  expectedCashMinor    Int?
  countedCashMinor     Int?
  differenceMinor      Int?
  status               CashSessionStatus @default(OPEN)
  activeVenueKey       String?           @unique
  openingNote          String?
  closingNote          String?
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue                Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  openedBy             Membership        @relation(fields: [openedByMembershipId], references: [id], onDelete: Restrict)
  shift                StaffShift        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  payments             PaymentRecord[]

  @@index([tenantId, venueId, status])
}

model TaxCategory {
  id                      String    @id @default(cuid())
  tenantId                String
  venueId                 String
  code                    String
  rateBasisPoints         Int
  dineInRateBasisPoints   Int?
  takeawayRateBasisPoints Int?
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue                   Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  products                Product[]

  @@unique([venueId, code])
  @@index([tenantId, venueId])
}

model ReceiptSequence {
  venueId    String @id
  tenantId   String
  lastNumber Int    @default(0)
  venue      Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Receipt {
  printJobs            PrintJob[]
  id                   String        @id @default(cuid())
  tenantId             String
  venueId              String
  orderId              String?       @unique
  onlineOrderId        String?       @unique
  paymentId            String        @unique
  sequence             Int
  number               String
  issuedAt             DateTime      @default(now())
  finalizedAt          DateTime      @default(now())
  status               ReceiptStatus @default(FINALIZED)
  snapshot             Json
  // P4 extension only. Never populated in P2.
  fiscalTransactionId  String?
  tseSerial            String?
  signatureCounter     BigInt?
  signature            String?
  transactionStartedAt DateTime?
  transactionEndedAt   DateTime?
  verificationPayload  String?
  exportReference      String?
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue                Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  payment              PaymentRecord @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  onlineOrder          OnlineOrder?  @relation(fields: [onlineOrderId], references: [id], onDelete: Restrict)

  @@unique([venueId, sequence])
  @@unique([venueId, number])
  @@index([tenantId, venueId, issuedAt])
}

enum PrintJobStatus {
  QUEUED
  PRINTING
  PRINTED
  FAILED
}

model HardwareDevice {
  id           String                  @id @default(cuid())
  tenantId     String
  venueId      String
  displayName  String
  mode         String
  fingerprint  String                  @unique
  publicKey    String?
  capabilities Json
  pairedAt     DateTime                @default(now())
  lastSeen     DateTime?
  active       Boolean                 @default(true)
  autoPrint    Boolean                 @default(false)
  autoDrawer   Boolean                 @default(false)
  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue        Venue                   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  jobs         PrintJob[]
  commands     HardwareCommandRecord[]

  @@index([tenantId, venueId, active])
}

model PrintJob {
  id            String         @id @default(cuid())
  tenantId      String
  venueId       String
  receiptId     String
  deviceId      String
  requestKey    String         @unique
  status        PrintJobStatus @default(QUEUED)
  attempts      Int            @default(0)
  lastErrorCode String?
  createdAt     DateTime       @default(now())
  printedAt     DateTime?
  commandId     String?        @unique
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue         Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  receipt       Receipt        @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  device        HardwareDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([tenantId, venueId, receiptId, createdAt])
}

model HardwareCommandRecord {
  id         String         @id @default(cuid())
  tenantId   String
  venueId    String
  deviceId   String
  receiptId  String?
  kind       String
  requestKey String         @unique
  payload    Json
  result     Json?
  createdAt  DateTime       @default(now())
  expiresAt  DateTime
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue      Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  device     HardwareDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([tenantId, venueId, deviceId, createdAt])
}

model CreativeProject {
  id                String                 @id @default(cuid())
  tenantId          String
  venueId           String
  title             String
  format            String
  locale            String
  status            String                 @default("DRAFT")
  version           Int                    @default(0)
  document          Json
  currentRevisionId String?
  createdBy         String
  updatedBy         String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  venue             Venue                  @relation(fields: [tenantId, venueId], references: [tenantId, id], onDelete: Cascade)
  revisions         CreativeRevision[]
  exports           CreativeExport[]
  conversations     CreativeConversation[]
  jobs              CreativeJob[]

  @@unique([tenantId, venueId, id])
  @@index([tenantId, venueId, updatedAt])
}

model CreativeRevision {
  id               String           @id @default(cuid())
  tenantId         String
  venueId          String
  projectId        String
  number           Int
  document         Json
  sourceSummary    Json
  actor            String
  createdBy        String
  name             String?
  parentRevisionId String?
  createdAt        DateTime         @default(now())
  project          CreativeProject  @relation(fields: [tenantId, venueId, projectId], references: [tenantId, venueId, id], onDelete: Cascade)
  exports          CreativeExport[]

  @@unique([projectId, number])
  @@unique([tenantId, venueId, projectId, id])
  @@index([tenantId, venueId, projectId])
}

model CreativeAsset {
  id                   String   @id @default(cuid())
  tenantId             String
  venueId              String
  name                 String
  source               String
  mimeType             String
  width                Int
  height               Int
  contentHash          String
  storageKey           String
  provenance           Json
  approvedForPublicUse Boolean  @default(false)
  approvedBy           String?
  createdBy            String
  createdAt            DateTime @default(now())
  venue                Venue    @relation(fields: [tenantId, venueId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, venueId, createdAt])
}

model CreativeExport {
  id            String           @id @default(cuid())
  tenantId      String
  venueId       String
  projectId     String
  revisionId    String
  outputType    String
  snapshot      Json
  snapshotHash  String
  contentHash   String
  specification Json
  storageKey    String
  requestKey    String
  createdBy     String
  createdAt     DateTime         @default(now())
  project       CreativeProject  @relation(fields: [tenantId, venueId, projectId], references: [tenantId, venueId, id], onDelete: Cascade)
  revision      CreativeRevision @relation(fields: [tenantId, venueId, projectId, revisionId], references: [tenantId, venueId, projectId, id], onDelete: Cascade)

  @@unique([tenantId, venueId, projectId, requestKey])
  @@index([tenantId, venueId, projectId, createdAt])
}

model CreativeConversation {
  id        String          @id @default(cuid())
  tenantId  String
  venueId   String
  projectId String
  message   String
  summary   String
  patch     Json
  createdBy String
  createdAt DateTime        @default(now())
  project   CreativeProject @relation(fields: [tenantId, venueId, projectId], references: [tenantId, venueId, id], onDelete: Cascade)

  @@index([tenantId, venueId, projectId, createdAt])
}

model CreativeJob {
  id         String          @id @default(cuid())
  tenantId   String
  venueId    String
  projectId  String
  requestKey String
  category   String
  state      String          @default("PENDING")
  provider   String
  model      String
  resultId   String?
  usage      Json
  durationMs Int             @default(0)
  createdBy  String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  project    CreativeProject @relation(fields: [tenantId, venueId, projectId], references: [tenantId, venueId, id], onDelete: Cascade)

  @@unique([tenantId, venueId, projectId, requestKey])
  @@index([tenantId, venueId, createdAt])
}
