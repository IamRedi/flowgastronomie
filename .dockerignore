# Allow only build inputs. In particular, no local environment or Git history.
**
!package.json
!package-lock.json
!tsconfig.base.json
!apps/
!apps/api/
!apps/api/package.json
!apps/api/tsconfig.json
!apps/api/src/
!apps/api/src/**
!apps/web/
!apps/web/package.json
!apps/web/next.config.ts
!apps/web/proxy.ts
!apps/web/next-env.d.ts
!apps/web/tsconfig.json
!apps/web/app/
!apps/web/app/**
!apps/web/components/
!apps/web/components/**
!apps/web/lib/
!apps/web/lib/**
!apps/web/public/
!apps/web/public/**
!packages/
!packages/domain/
!packages/domain/package.json
!packages/domain/tsconfig.json
!packages/domain/src/
!packages/domain/src/**
!packages/database/
!packages/database/package.json
!packages/database/tsconfig.json
!packages/database/src/
!packages/database/src/**
!packages/database/prisma/
!packages/database/prisma/schema.prisma
!packages/database/prisma/migrations/
!packages/database/prisma/migrations/**
!infra/
!infra/production/
!infra/production/build-api.mjs
!infra/production/healthcheck.mjs
!infra/production/backup.py
!infra/production/backup.sh
!infra/production/operations/
!infra/production/operations/package.json
!infra/production/operations/package-lock.json
**/*.test.*
**/*.integration.test.*
# Defense in depth inside every re-included source directory.
**/.env*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/node_modules
**/.next
**/dist
**/.git
**/*.tsbuildinfo
**/*.log
